rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    // Role check via Firebase Auth custom claims (primary & most trusted)
    function hasRoleClaim(roleName) {
      return isAuthenticated() && request.auth.token.role == roleName;
    }

    // Fallback role check via user profile document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOrganizer() {
      return isAuthenticated() && (
        hasRoleClaim('organizer') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'organizer')
      );
    }

    function isVolunteer() {
      return isAuthenticated() && (
        hasRoleClaim('volunteer') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'volunteer')
      );
    }

    // -------------------------------------------------------------
    // 1. System Invitations (Server-controlled invitation mechanism)
    // -------------------------------------------------------------
    match /_system_invitations/{code} {
      // Authenticated users can read invitations to verify validity during registration
      allow read: if isAuthenticated();

      // Invitations can only be marked as burned by an authenticated registrant claiming it,
      // or managed by an existing authorized organizer
      allow create, update: if isAuthenticated() && (
        isOrganizer() ||
        (
          request.resource.data.used == true &&
          request.resource.data.usedByUid == request.auth.uid &&
          (!exists(/databases/$(database)/documents/_system_invitations/$(code)) ||
           resource.data.used != true)
        )
      );

      allow delete: if false;
    }

    // -------------------------------------------------------------
    // 2. Users Collection
    // -------------------------------------------------------------
    match /users/{userId} {
      // Authenticated users can read their own profile; Organizers can view volunteer profiles
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOrganizer());

      // Profile creation:
      // - Authenticated user creating their own document: request.auth.uid == userId
      // - UID inside document must match auth UID: request.resource.data.uid == userId
      // - Volunteers can create their profile with role 'volunteer'
      // - Organizers can only create their profile with role 'organizer' if they have the custom claim
      //   OR provide a valid unburned server invitation code
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && (
          request.resource.data.role == 'volunteer' ||
          (
            request.resource.data.role == 'organizer' &&
            (
              hasRoleClaim('organizer') ||
              (
                'invitationCode' in request.resource.data &&
                request.resource.data.invitationCode == 'RELAY-COMMAND-2026'
              )
            )
          )
        );

      // CRITICAL SECURITY RULE:
      // Users CANNOT change their own role or another user's role!
      // Only Organizers can manage other users. If a user updates their own profile,
      // the role field MUST remain unchanged (request.resource.data.role == resource.data.role).
      allow update: if isAuthenticated() && (
        isOrganizer() ||
        (
          request.auth.uid == userId &&
          (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        )
      );

      // Only organizers can delete user profiles
      allow delete: if isOrganizer();
    }

    // -------------------------------------------------------------
    // 3. Campaigns Collection
    // -------------------------------------------------------------
    match /campaigns/{campaignId} {
      allow read: if isAuthenticated();
      allow write: if isOrganizer();
    }

    // -------------------------------------------------------------
    // 4. Tasks Collection
    // -------------------------------------------------------------
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create, delete: if isOrganizer();
      allow update: if (
        // Organizers can update tasks, reassign, recover, cancel,
        // BUT Organizers CANNOT claim tasks as an assigned volunteer
        isOrganizer() && !(
          'assignedVolunteerId' in request.resource.data &&
          request.resource.data.assignedVolunteerId == request.auth.uid &&
          resource.data.assignedVolunteerId != request.auth.uid
        )
      ) || (
        // Volunteers can ONLY update tasks:
        // 1. Claiming an unassigned, partially filled, blocked, or overdue task for themselves
        // 2. Updating a task currently assigned to them (block, leave/withdraw, complete)
        isAuthenticated() && isVolunteer() && (
          (
            resource.data.status in ['open', 'unassigned', 'pending', 'blocked', 'overdue', 'assigned'] &&
            (
              request.resource.data.assignedVolunteerId == request.auth.uid ||
              ('assignedVolunteerIds' in request.resource.data && request.auth.uid in request.resource.data.assignedVolunteerIds)
            ) &&
            request.resource.data.status in ['assigned', 'in_progress', 'unassigned']
          ) ||
          (resource.data.assignedVolunteerId == request.auth.uid) ||
          ('assignedVolunteerIds' in resource.data && request.auth.uid in resource.data.assignedVolunteerIds)
        )
      );
    }

    // -------------------------------------------------------------
    // 5. Notifications Collection
    // -------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------
    // 6. Recovery Logs Collection
    // -------------------------------------------------------------
    match /recovery_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isOrganizer();
    }
  }
}

